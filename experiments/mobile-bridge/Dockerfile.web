FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg ca-certificates python3 make g++ && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json ./
RUN npm install --omit=dev --no-audit --no-fund
COPY package-adapter.mjs web-policy.mjs web-service.mjs public-policy.mjs ./
USER node
ENV NODE_ENV=production PORT=8080
EXPOSE 8080
CMD ["node","web-service.mjs"]
